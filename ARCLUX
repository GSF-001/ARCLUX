677: // ──────────────────────────────────────────────────────────────────────────
678: // Tool handlers
679: // ──────────────────────────────────────────────────────────────────────────
680: async function handleTool(name: string, args: Record<string, unknown>) {
681:   switch (name) {
682: 
683:     // ── Core ──────────────────────────────────────────────────────
684:     case "analyze": {
685:       const r = await doAnalyze(args);
686:       return json({
687:         meta: r.meta, moduleCount: r.moduleCount, scanSummary: r.scanSummary,
688:         graph: { nodeCount: r.graph.nodes.length, edgeCount: r.graph.edges.length },
689:         dependencies: r.dependencies,
690:       });
691:     }
692:     case "doctor": {
693:       const r = await doAnalyze(args);
694:       return json(runDoctor(r.repository));
695:     }
696:     case "health": {
697:       const r = await doAnalyze(args);
698:       const dr = runDoctor(r.repository);
699:       return json(computeHealthScore(dr.findings, r.moduleCount));
700:     }
701:     case "verify": {
702:       const r = await doAnalyze(args);
703:       const result = runAllChecks(r.repository);
704:       return json({ verdict: result.errorCount === 0 ? "PASS" : "FAIL", ...result });
705:     }
706:     case "diagnose": {
707:       const r = await doAnalyze(args);
708:       const findings = runDiagnostics(r.repository);
709:       return json({ findings, fixes: getFixSuggestions(findings) });
710:     }
711: 
712:     // ── Graphs ─────────────────────────────────────────────────────
713:     case "callgraph": {
714:       const r = await doAnalyze(args);
715:       const g = buildCallGraph(r.repository);
716:       return json({ nodes: g.nodes, edges: g.edges });
717:     }
718:     case "dependency_graph": {
719:       const r = await doAnalyze(args);
720:       const g = buildDependencyGraph(r.repository);
721:       return json({ nodes: g.nodes, edges: g.edges });
722:     }
723:     case "export_graph": {
724:       const r = await doAnalyze(args);
725:       const g = buildExportGraph(r.repository);
726:       return json({ nodes: g.nodes, edges: g.edges });
727:     }
728:     case "folder_graph": {
729:       const r = await doAnalyze(args);
730:       return json(buildFolderGraph(r.repository));
731:     }
732: 
733:     // ── Impact ─────────────────────────────────────────────────────
734:     case "impact": {
735:       const r = await doAnalyze(args);
736:       const mid = resolveImpactModuleId(r.repository, args.moduleId as string);
737:       return json({
738:         requestedModuleId: args.moduleId,
739:         resolvedModuleId: mid,
740:         tree: buildImpactTree(r.repository, mid),
741:         affectedFiles: calculateAffectedFiles(r.repository, mid),
742:         affectedRoutes: calculateAffectedRoutes(r.repository, mid),
743:       });
744:     }
745:     case "impact_consumers": {
746:       const r = await doAnalyze(args);
747:       const mid = resolveImpactModuleId(r.repository, args.moduleId as string);
748:       const result = traceConsumers(r.repository, mid);
749:       // Enrich notFound with hint
750:       if (result.notFound) {
751:         return json({ ...result, requestedModuleId: args.moduleId, resolvedModuleId: mid, hint: "Module not found — try file_info or analyze to list available modules" });
752:       }
753:       return json({ ...result, requestedModuleId: args.moduleId, resolvedModuleId: mid });
754:     }
755:     case "impact_dependencies": {
756:       const r = await doAnalyze(args);
757:       const mid = resolveImpactModuleId(r.repository, args.moduleId as string);
758:       const result = traceDependencies(r.repository, mid);
759:       if (result.notFound) {
760:         return json({ ...result, requestedModuleId: args.moduleId, resolvedModuleId: mid, hint: "Module not found — try file_info or analyze to list available modules" });
761:       }
762:       return json({ ...result, requestedModuleId: args.moduleId, resolvedModuleId: mid });
763:     }
764: 
765:     // ── Security ───────────────────────────────────────────────────
766:     case "security": {
767:       const r = await doAnalyze(args);
768:       const sec = analyzeRepositorySecurity(r.repository, r.meta.rootPath);
769:       const graph = buildCallGraph(r.repository);
770:       return json({ security: sec, attackSurface: mapAttackSurface(r.repository, graph) });
771:     }
772: 
773:     // ── Search ─────────────────────────────────────────────────────
774:     case "search": {
775:       const r = await doAnalyze(args);
776:       const idx = buildSearchIndex(r.repository);
777:       return json(search(idx, args.query as string, { limit: (args.limit as number) ?? 50 }));
778:     }
779: 
780:     // ── Detect ─────────────────────────────────────────────────────
781:     case "detect": {
782:       const r = await doAnalyze(args);
783:       const names = (args.detectors as string[]) ?? [];
784:       const runAll = names.includes("all");
785:       const targets = runAll ? DETECTOR_NAMES : names;
786:       const results: Record<string, any> = {};
787:       let total = 0;
788:       for (const n of targets) {
789:         const fn = DETECTOR_MAP[n];
790:         if (!fn) { results[n] = { error: "Unknown: " + n + ". Available: " + DETECTOR_NAMES.join(", ") }; continue; }
791:         const findings = fn(r.repository);
792:         results[n] = { count: findings.length, findings };
793:         total += findings.length;
794:       }
795:       return json({ totalFindings: total, detectors: results });
796:     }
797: 
798:     // ── Diff ───────────────────────────────────────────────────────
799:     case "diff": {
800:       const r = await doAnalyze(args);
801:       return json(computeArchitecturalDiff(r.repository, r.meta.rootPath, args.refA as string, args.refB as string));
802:     }
803:     case "semantic_diff": {
804:       const r = await doAnalyze(args);
805:       return json(computeSemanticDiff({ repository: r.repository, repoPath: r.meta.rootPath, refA: args.refA as string, refB: args.refB as string }));
806:     }
807: 
808:     // ── Git ────────────────────────────────────────────────────────
809:     case "branches": {
810:       return json({ branches: getBranches(args.repoUrl as string), defaultBranch: detectDefaultBranch(args.repoUrl as string) });
811:     }
812:     case "history": {
813:       const fn = async (localPath: string) => {
814:         const commits = await getCommitHistory(localPath, { maxCount: (args.maxCount as number) ?? 20, branch: args.branch as string });
815:         const contributors = await getContributors(localPath);
816:         return { commits, contributors };
817:       };
818:       const result = args.localPath ? await fn(args.localPath as string) : await withClone(args.repoUrl as string, args.branch as string, fn);
819:       return json(result);
820:     }
821: 
822:     // ── Editor ─────────────────────────────────────────────────────
823:     case "file_info": {
824:       const r = await doAnalyze(args);
825:       const mod = resolveFile(args.filePath as string, r.repository);
826:       // ModuleInfo.imports is string[] (resolved moduleIds); identifier detail is in resolvedImports
827:       const imports = (mod.resolvedImports ?? []).map((i: any) => ({ source: i.moduleId, names: i.namedImports, kind: i.kind, line: i.line }));
828:       // Fallback to raw imports if resolvedImports empty (external-only deps)
829:       const importView = imports.length ? imports : (mod.imports ?? []).map((id: string) => ({ source: id, names: [] as string[] }));
830:       return json({
831:         moduleId: mod.id, filePath: mod.file.relativePath,
832:         exports: mod.exports.map((e: any) => ({ name: e.name, kind: e.kind, line: e.line })),
833:         imports: importView,
834:         calls: mod.calls.map((c: any) => ({ calleeName: c.calleeName, moduleId: c.moduleId, line: c.line })),
835:         // keep legacy string arrays for backward compat as well
836:         callsLegacy: mod.calls.map((c: any) => c.calleeName),
837:         dependencies: listDependencyTargets(r.repository, mod.id),
838:         consumers: listDirectConsumerTargets(r.repository, mod.id),
839:         importedBy: mod.importedBy,
840:         calledBy: mod.calledBy,
841:       });
842:     }
843: 
844:     // ── Parser (standalone — TS/JS via Compiler API, tree-sitter via analyze) ──
845:     case "parse_file": {
846:       const filePath = args.filePath as string;
847:       const ext = (args.extension as string) ?? undefined;
848:       const content = args.content as string | undefined;
849: 
850:       const dotExt = ext ?? ("." + filePath.split(".").pop());
851:       const language = detectLanguage(dotExt);
852: 
853:       // Tree-sitter languages (Python, Go, Java, etc.) need WASM runtime.
854:       // Direct standalone parsing isn't available in MCP mode — use
855:       // `analyze` + `file_info` for these. The error message tells the agent.
856:       if (TREE_SITTER_EXTENSIONS.includes(dotExt.toLowerCase())) {
857:         throw new Error(
858:           dotExt + " (" + language + ") requires WASM runtime. Use: "
859:           + 'analyze {repoUrl/localPath} → file_info {filePath: "' + filePath + '"}'
860:         );
861:       }
862: 
863:       // TS/JS files — use the TypeScript Compiler API (no WASM needed).
864:       let fileContent = content;
865:       if (!fileContent) {
866:         const fs = await import("node:fs/promises");
867:         const basePath = args.localPath as string;
868:         if (!basePath) throw new Error("localPath required when content is omitted");
869:         const fullPath = basePath.startsWith("/") ? basePath + "/" + filePath : basePath + "/" + filePath;
870:         fileContent = await fs.readFile(fullPath, "utf-8");
871:       }
872: 
873:       const ts = await import("typescript");
874:       const sourceFile = ts.createSourceFile(filePath, fileContent!, ts.ScriptTarget.Latest, true);
875: 
876:       const exports: any[] = [];
877:       const imports: any[] = [];
878:       const calls: any[] = [];
879: 
880:       ts.forEachChild(sourceFile, function visit(node) {
881:         // Exports
882:         if (ts.isExportAssignment(node)) {
883:           exports.push({ name: "default", kind: "default", line: sourceFile.getLineAndCharacterOfPosition(node.getStart()).line + 1 });
884:         } else if (ts.isFunctionDeclaration(node) && node.name) {
885:           const hasExport = node.modifiers?.some(m => m.kind === ts.SyntaxKind.ExportKeyword);
886:           if (hasExport) exports.push({ name: node.name.text, kind: "function", line: sourceFile.getLineAndCharacterOfPosition(node.getStart()).line + 1 });
887:         } else if (ts.isVariableStatement(node) && node.modifiers?.some(m => m.kind === ts.SyntaxKind.ExportKeyword)) {
888:           for (const decl of node.declarationList.declarations) {
889:             if (ts.isIdentifier(decl.name)) exports.push({ name: decl.name.text, kind: "variable", line: sourceFile.getLineAndCharacterOfPosition(decl.getStart()).line + 1 });
890:           }
891:         } else if (ts.isClassDeclaration(node) && node.name) {
