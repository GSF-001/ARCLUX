{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "ARCLUX",
  "colors": {
    "primary": "#4DE3FF",
    "light": "#7CEDFF",
    "dark": "#0F9BB8"
  },
  "favicon": "/static/img/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "icon": {
          "library": "lucide",
          "name": "rocket"
        },
        "pages": [
          "overview",
          "quickstart",
          "usage",
          "how-to-use",
          "tutorial",
          "skill"
        ]
      },
      {
        "group": "Reference",
        "icon": {
          "library": "lucide",
          "name": "book-open"
        },
        "pages": [
          "about",
          "architecture",
          "stack",
          "status",
          "gotchas",
          "tooling",
          "guides",
          "deep-dive",
          "examples"
        ]
      },
      {
        "group": "Codebase Map",
        "icon": {
          "library": "lucide",
          "name": "folder-tree"
        },
        "pages": [
          {
            "group": "Intelligence",
            "pages": [
              "map/intelligence/acquisition",
              "map/intelligence/adapters",
              "map/intelligence/boundaries",
              "map/intelligence/correlation",
              "map/intelligence/detectors",
              "map/intelligence/diagnostics",
              "map/intelligence/diff",
              "map/intelligence/directory",
              "map/intelligence/dsl",
              "map/intelligence/engine",
              "map/intelligence/git",
              "map/intelligence/graph",
              "map/intelligence/impact",
              "map/intelligence/indexer",
              "map/intelligence/language",
              "map/intelligence/mcp",
              "map/intelligence/parser",
              "map/intelligence/provenance",
              "map/intelligence/relay",
              "map/intelligence/remote-analysis",
              "map/intelligence/remote",
              "map/intelligence/repository",
              "map/intelligence/rules",
              "map/intelligence/search",
              "map/intelligence/security-analysis",
              "map/intelligence/security",
              "map/intelligence/semantic-diff",
              "map/intelligence/shared",
              "map/intelligence/ui",
              "map/intelligence/universe"
            ],
            "defaultOpen": true
          },
          {
            "group": "Platform",
            "pages": [
              "map/platform/cache",
              "map/platform/change",
              "map/platform/daemon",
              "map/platform/db",
              "map/platform/editor",
              "map/platform/environment",
              "map/platform/incremental",
              "map/platform/kernel",
              "map/platform/networking",
              "map/platform/notifications",
              "map/platform/observation",
              "map/platform/orchestration",
              "map/platform/package-manager",
              "map/platform/runtime",
              "map/platform/scheduler",
              "map/platform/services",
              "map/platform/shell",
              "map/platform/storage",
              "map/platform/system",
              "map/platform/terminal",
              "map/platform/watcher",
              "map/platform/web-intake",
              "map/platform/workspace"
            ],
            "defaultOpen": true
          },
          {
            "group": "Apps",
            "pages": [
              "map/apps/cli",
              "map/apps/vscode-extension",
              "map/apps/web"
            ],
            "defaultOpen": false
          }
        ]
      },
      {
        "group": "Release",
        "icon": {
          "library": "lucide",
          "name": "tag"
        },
        "pages": [
          "changelog"
        ]
      }
    ]
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "color": {
      "dark": "#000000"
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "GitHub",
      "href": "https://github.com/GSF-001/ARCLUX"
    }
  },
  "fonts": {
    "heading": {
      "family": "Isometra"
    },
    "body": {
      "family": "Inter"
    }
  },
  "description": "Open-source codebase intelligence -- live dependency graphs, impact tracing, detectors, conventions, DSL.",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "codeblocks": {
      "theme": "catppuccin-mocha"
    }
  }
}
