#!/usr/bin/env bash
# Blok commit kalau ada header ## baru di progres/PROGRES-*.md tanpa tanggal YYYY-MM-DD
set -e

SKIP_HEADERS="Rules for using this file|Active assignments|Completed|Still empty, priority order for next session|Problems that happened before|External references already used"

STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep '^progres/PROGRES-.*\.md$' || true)

if [ -z "$STAGED" ]; then
  exit 0
fi

FAIL=0
for f in $STAGED; do
  while IFS= read -r line; do
    title=$(echo "$line" | sed 's/^## //')
    if echo "$title" | grep -qE "$SKIP_HEADERS"; then
      continue
    fi
    if ! echo "$title" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2} — '; then
      echo "BLOCKED: $f punya header tanpa tanggal: ## $title"
      FAIL=1
    fi
  done < <(grep '^## ' "$f")
done

if [ "$FAIL" -eq 1 ]; then
  echo ""
  echo "Commit ditolak. Pakai scripts/log-progress.sh atau tambahin tanggal manual (format: ## YYYY-MM-DD — judul)."
  exit 1
fi

# P-003 guard (mechanical): AGENT_DIARY.md is gitignored but must stay
# structurally valid — an edit that replaces an entry header leaves the
# body orphaned. Best-effort: only runs when tsx is available, so a
# contributor without the toolchain is never blocked.
if [ -f AGENT_DIARY.md ] && { [ -x node_modules/.bin/tsx ] || command -v tsx >/dev/null 2>&1; }; then
  if ! npx --no-install tsx scripts/check-diary.ts >/dev/null 2>&1; then
    echo ""
    echo "BLOCKED: AGENT_DIARY.md structure broken (orphaned entry body — P-003)."
    echo "Run: npx tsx scripts/check-diary.ts"
    exit 1
  fi
fi
